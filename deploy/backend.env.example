FIREFLY_URL=http://firefly.example
FIREFLY_TOKEN=replace_me
SECRET_KEY=replace_with_a_long_random_value
ALGORITHM=HS256
DEMO_MODE=False
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
ALLOWED_ORIGINS=https://toolkit.example
BLIK_DESCRIPTION_FILTER="BLIK - płatność w internecie"
TAG_BLIK_DONE="blik_done"
TRANSACTION_SNAPSHOT_TTL_SECONDS=300

# REDIS_URL is provided by Compose on the private Redis network.

# Snapshot freshness uses fetched_at; Redis retention is time since the last write.
TRANSACTION_SNAPSHOT_RETENTION_SECONDS=86400
# Use a distinct key for each independent Firefly dataset sharing Redis.
TRANSACTION_SNAPSHOT_REDIS_KEY=ff-iii-toolkit:snapshot:v1:transactions
