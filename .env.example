FIREFLY_URL=http://0.0.0.0
FIREFLY_TOKEN=replace_me
SECRET_KEY=supersecretchangeme
ALGORITHM=HS256
DEMO_MODE=False
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOG_LEVEL=INFO
#ALLOWED_ORIGINS=*
ALLOWED_ORIGINS=0.0.0.0,localhost:5173,http://localhost:8000

BLIK_DESCRIPTION_FILTER="BLIK - płatność w internecie"
TAG_BLIK_DONE="blik_done"
TRANSACTION_SNAPSHOT_TTL_SECONDS=300

# Optional for a host-run backend; start compose.redis-dev.yaml first.
# REDIS_URL=redis://127.0.0.1:6379/0

# Snapshot freshness uses fetched_at; Redis retention is time since the last write.
TRANSACTION_SNAPSHOT_RETENTION_SECONDS=86400
# Use a distinct key for each independent Firefly dataset sharing Redis.
TRANSACTION_SNAPSHOT_REDIS_KEY=ff-iii-toolkit:snapshot:v1:transactions

# Cross-process snapshot refresh: lease > the 180s Firefly fetch budget.
TRANSACTION_SNAPSHOT_REFRESH_LEASE_SECONDS=210
# Finite caller/task budget, including waiting for another owner.
TRANSACTION_SNAPSHOT_REFRESH_TIMEOUT_SECONDS=220
